APP_NAME="Projeto Lâmpada"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Configurações de Banco de Dados (Padrão Laravel Sail / MySQL local)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=lampada
DB_USERNAME=sail
DB_PASSWORD=password

# Sessão, Cache e Filas
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# Configurações de E-mail
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="contato@projetolampada.com.br"
MAIL_FROM_NAME="${APP_NAME}"

# Inteligência Artificial (Google Gemini via Laravel AI SDK)
GEMINI_API_KEY=

# Autenticação Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL="${APP_URL}/auth/google/callback"

# Google Cloud Text-to-Speech (TTS)
GOOGLE_TTS_API_KEY=

# Google Cloud Storage & Project (Opcional para ambiente local)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_CLOUD_STORAGE_BUCKET=

# API Bíblia Digital
ABIBLIA_DIGITAL_BASE_URL="https://abibliadigital.api.br/api"
ABIBLIA_DIGITAL_VERSION="nvi"

VITE_APP_NAME="${APP_NAME}"
